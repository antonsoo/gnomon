{
  "name": "gnomon",
  "version": "0.2.2",
  "description": "Design accurate, printable sundials for any place on Earth: horizontal, vertical, equatorial and analemmatic, with scale-exact SVG/PDF export and a 3D ray-casting oracle test suite.",
  "author": "Anton Soloviev",
  "license": "MIT",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonsoo/gnomon.git"
  },
  "homepage": "https://antonsoo.github.io/gnomon/",
  "keywords": [
    "sundial",
    "gnomonics",
    "astronomy",
    "svg",
    "laser-cutting",
    "equation-of-time",
    "typescript",
    "solar-position"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.15.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.2"
  }
}
